# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# TokenReply API key (keep this secret)
TOKENREPLY_API_KEY=

# Copy an exact model ID available to your TokenReply account
TOKENREPLY_MODEL=beam-free

# TokenReply OpenAI-compatible API base URL
TOKENREPLY_BASE_URL=https://api.tokenreply.com/v1

# Maximum number of previous messages kept per chat (user + assistant messages)
HISTORY_MAX_MESSAGES=24